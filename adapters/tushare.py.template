import os

from btcore.generic_sql import GenericSQLBackend

# 默认行情库路径；可用环境变量 DDUP_MARKET_DB 覆盖（与真实实现同口径）
_DEFAULT_DB_PATH = os.environ.get(
    "DDUP_MARKET_DB", "<YOUR_TUSHARE_DB_PATH>"  # 如 "/data/tushare/market.db"
)


def get_default_db_path() -> str:
    """默认行情库路径（research/CLI 消费，替代正则解析本文件源码）。

    环境变量 DDUP_MARKET_DB 可覆盖默认值。"""
    return _DEFAULT_DB_PATH

TUSHARE_FORM = {
    # ══ 索引键名：只填列名，不带表名 ══
    "symbol": "ts_code",                    # 证券代码列名
    "date": "trade_date",                   # 交易日列名（YYYYMMDD 字符串）

    # ══ 数据契约字段（全部必填）══
    # 行情统一走 stk_factor_pro 表（已切离 tushare daily 低积分表，见真实实现）
    "open": "stk_factor_pro.open",                   # 开盘价（元），裸价
    "high": "stk_factor_pro.high",                   # 最高价（元），裸价
    "low": "stk_factor_pro.low",                     # 最低价（元），裸价
    "close": "stk_factor_pro.close",                 # 收盘价（元），裸价
    "vol": "stk_factor_pro.vol",                     # 成交量（手）
    "adj_factor": "stk_factor_pro.adj_factor",       # 后复权因子（hfq = 裸价 × adj_factor）
    "pre_close": "stk_factor_pro.pre_close",         # 昨收价，交易所除权口径
    "up_limit": "stk_limit.up_limit",       # 精确涨停价（元）
    "down_limit": "stk_limit.down_limit",   # 精确跌停价（元）

    # ══ 交易日历与分红（全部必填）══
    "calendar_date": "trade_cal.cal_date",         # 交易日历日期列
    "dividend_ex_date": "dividend.ex_date",        # 除权除息日
    "dividend_stk_div": "dividend.stk_div",        # 每股送转比例（10送3 → 0.3）
    "dividend_cash_div": "dividend.cash_div",      # 每股现金红利（元）

    # ══ 辅助能力（可选：不填 = 对应功能关闭）══
    "st_symbol": "stock_st.ts_code",              # ST 标记，启用 exclude_st 过滤
    "industry_name": "index_member_all.l1_name",  # 行业分类，启用行业分组/过滤
    "listing_date": "stock_basic.list_date",      # 上市日期，启用新股过滤
    "index_code": "index_weight.index_code",      # 指数代码（与 index_member 成对填写）
    "index_member": "index_weight.con_code",      # 指数成分股，启用成分池限定
    "benchmark_close": "idx_factor_pro.close",  # 基准收盘价（指数点位，无复权概念）
    "benchmark_code": "000300.SH",                # 默认基准代码（沪深300）

    # ══ 扩展字段（按需取消注释/添加，格式："字段名": "表名.列名"；
    #   真实实现已登记大量 stk_factor_pro 技术指标/基本面字段，见 adapters/tushare.py）══
    "extra_fields": {
        # -- 基本面/估值（stk_factor_pro 同表，零成本）--
        # "turnover_rate": "stk_factor_pro.turnover_rate",  # 换手率
        # "pe_ttm": "stk_factor_pro.pe_ttm",                # 市盈率（TTM）
        # "pb": "stk_factor_pro.pb",                        # 市净率
        # "total_mv": "stk_factor_pro.total_mv",            # 总市值

        # -- 资金流向（moneyflow 表）--
        # "net_mf_amount": "moneyflow.net_mf_amount",    # 净流向额

        # -- 筹码分布（cyq_perf 表）--
        # "winner_rate": "cyq_perf.winner_rate",         # 获利盘比例

        # -- 融资融券（margin_detail 表）--
        # "rzye": "margin_detail.rzye",                  # 融资余额
    },

    # ══ 表的特殊说明 ══
    "tables": {
        "trade_cal": {"filter": {"exchange": "SSE", "is_open": 1}},     # 过滤上交所开市日
        "dividend": {"filter": {"div_proc": "实施", "ex_date": None}},   # 过滤已实施、排除空日期
        "stock_st": {"filter": {"type": "ST"}},                          # 只取 ST 类型
    },
}


class TushareBackend(GenericSQLBackend):
    """tushare 库后端。"""

    def __init__(self, db_path: str = _DEFAULT_DB_PATH):
        super().__init__(TUSHARE_FORM, db_path)
